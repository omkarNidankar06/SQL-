SELECT * FROM products;

----Get all the Uppercase

SELECT UPPER(category) AS Category_Capital
FROM products;

----Get all the Lowercase
SELECT LOWER(category) AS Category_Capital
FROM products;

--join product_name and catagory text with hypen.--
SELECT CONCAT(product_name,'_',category) AS product_details
FROM products;

--Extarct the first 5 characters from product_name
SELECT SUBSTRING(product_name, 1,5) AS short_name
FROM products;

--Count length
SELECT product_name, LENGTH(product_name) AS COUNT_OF_CHARATER
FROM products;

----Remove and trailing spaces from string
SELECT LENGTH (TRIM('   Monitor  '))AS Trimmed_Text;

--Replace the word "phone" with "device" in product names
SELECT REPLACE(product_name,'phone','device') AS updated
FROM products;

----Get the first 3 characters from category 

SELECT RIGHT(category, 3) AS Category_Capital
FROM products;
